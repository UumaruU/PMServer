generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RepeatMode {
  OFF
  ONE
  ALL
}

enum HistoryEventType {
  STARTED
  PROGRESS
  PAUSED
  COMPLETED
  SKIPPED
}

enum RecommendationEventType {
  PLAYBACK
  FAVORITE
  PLAYLIST
  DISLIKE
  IMPRESSION
  INTERACTION
}

model User {
  id                     String                      @id @default(uuid()) @db.Uuid
  login                  String                      @unique
  email                  String                      @unique
  passwordHash           String
  username               String?
  displayName            String?
  avatarUrl              String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  refreshTokens          RefreshToken[]
  favorites              Favorite[]
  playlists              Playlist[]
  settings               UserSettings?
  historyEvents          UserHistoryEvent[]
  searchHistoryEntries   UserSearchHistoryEntry[]
  recommendationProfile  UserRecommendationProfile?
  recommendationCache    UserRecommendationCacheEntry[]
  recommendationEvents   UserRecommendationEvent[]
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String
  deviceName String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Track {
  id                     String             @id @default(uuid()) @db.Uuid
  clientTrackId          String?            @unique
  source                 String
  sourceTrackId          String
  title                  String
  artistName             String
  albumTitle             String?
  duration               Int?
  coverUrl               String?
  audioUrl               String?
  musicBrainzRecordingId String?
  musicBrainzArtistId    String?
  musicBrainzReleaseId   String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  favorites              Favorite[]
  playlistTracks         PlaylistTrack[]
  historyEvents          UserHistoryEvent[]
  recommendationEvents   UserRecommendationEvent[]

  @@unique([source, sourceTrackId])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  trackId   String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
}

model Playlist {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @db.Uuid
  trackId    String   @db.Uuid
  position   Int
  createdAt  DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

model UserSettings {
  userId          String     @id @db.Uuid
  language        String     @default("en")
  volume          Int        @default(100)
  repeatMode      RepeatMode @default(OFF)
  muted           Boolean    @default(false)
  shuffleEnabled  Boolean    @default(false)
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserHistoryEvent {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  trackId    String           @db.Uuid
  eventType  HistoryEventType
  playedMs   Int?
  context    Json?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  track      Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserSearchHistoryEntry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  query      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserRecommendationProfile {
  userId           String   @id @db.Uuid
  bootstrapProfile Json
  shortTermProfile Json
  longTermProfile  Json
  sessionProfile   Json
  entityProfile    Json
  profileRevision  Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRecommendationCacheEntry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  cacheKey   String
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cacheKey])
  @@index([userId])
}

model UserRecommendationEvent {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @db.Uuid
  trackId    String?                 @db.Uuid
  eventType  RecommendationEventType
  payload    Json
  createdAt  DateTime                @default(now())
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  track      Track?                  @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([trackId])
}
